---
import Base from '../layouts/Base.astro';
import { t, pagePath, type Locale, type PageKey } from '../i18n';
import type { UIKey } from '../i18n/fr';

// Une seule page 404 pour tout le site : on l'affiche en français puis en anglais.
const useful: { key: PageKey; label: UIKey }[] = [
  { key: 'projects', label: 'notFound.projects' },
  { key: 'news', label: 'nav.news' },
  { key: 'reports', label: 'footer.reportsLong' },
  { key: 'contact', label: 'nav.contact' },
];
const blocs: Locale[] = ['fr', 'en'];
---
<Base lang="fr" title={`${t('fr', 'notFound.title')} / ${t('en', 'notFound.title')}`} pageKey={null} noindex>
  {blocs.map((lang, i) => (
    <section class:list={['sec page404', { alt: i === 1 }]} lang={lang}>
      <div class="wrap"><div class="stack-l narrow">
        <div class="stack">
          <p class="kicker">{t(lang, 'notFound.kicker')}</p>
          {i === 0 ? <h1>{t(lang, 'notFound.title')}</h1> : <h2 class="h1-like">{t(lang, 'notFound.title')}</h2>}
          <p class="lead">{t(lang, 'notFound.text')}</p>
        </div>
        <div class="row">
          <a class="btn btn-p btn-full-m" href={pagePath(lang, 'home')}>{t(lang, 'notFound.back')}</a>
          <a class="btn btn-s btn-full-m" href={pagePath(lang, 'contact')}>{t(lang, 'notFound.report')}</a>
        </div>
        <div class="stack-s">
          <h3 class="useful-t">{t(lang, 'notFound.useful')}</h3>
          <ul class="plain useful">
            {useful.map((u) => <li><a class="lnk" href={pagePath(lang, u.key)}>{t(lang, u.label)}</a></li>)}
          </ul>
        </div>
      </div></div>
    </section>
  ))}
</Base>
<style>
  .page404 { padding-top: 48px; padding-bottom: 48px; }
  .h1-like { font-size: 28px; line-height: 1.25; }
  .useful-t { font-size: 18px; }
  .useful { display: flex; flex-wrap: wrap; gap: 0 24px; }
  .useful a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 1024px) {
    .page404 { padding-top: 72px; padding-bottom: 72px; }
    .h1-like { font-size: 40px; line-height: 1.2; }
    .useful-t { font-size: 20px; }
  }
</style>
