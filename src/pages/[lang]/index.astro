---
import Base from '../../layouts/Base.astro';
import UnderConstruction from '../../components/UnderConstruction.astro';
import { settings } from '../../lib/settings';
import { locales, pick, pagePath, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const alternates = { fr: pagePath('fr', 'home'), en: pagePath('en', 'home') };
---
<Base lang={lang} title={settings.sigle} pageKey="home" alternates={alternates}>
  <UnderConstruction lang={lang} title={pick(settings.nom, lang)} />
</Base>
