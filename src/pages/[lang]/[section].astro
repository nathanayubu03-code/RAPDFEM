---
import Base from '../../layouts/Base.astro';
import UnderConstruction from '../../components/UnderConstruction.astro';
import { locales, slugs, t, navLabel, pagePath, type Locale, type SectionKey } from '../../i18n';

// Étape 1 : une page « En construction » par entrée du menu.
// Chaque page sera remplacée par sa vraie version à l'étape 4.
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    (Object.keys(slugs[lang]) as SectionKey[]).map((key) => ({
      params: { lang, section: slugs[lang][key] },
      props: { key },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const { key } = Astro.props as { key: SectionKey };
const title = t(lang, navLabel[key]);
const alternates = { fr: pagePath('fr', key), en: pagePath('en', key) };
---
<Base lang={lang} title={title} pageKey={key} alternates={alternates}>
  <UnderConstruction lang={lang} title={title} />
</Base>
