---
import ProjetDetail from '../../../views/ProjetDetail.astro';
import Details from '../../../views/Details.astro';
import { publies } from '../../../lib/contenu';
import { locales, slugs, type Locale } from '../../../i18n';

// Pages de détail : seuls les éléments publiés ont une page.
export async function getStaticPaths() {
  const [projets, actualites, evenements, activites, offres] = await Promise.all([
    publies('projets'), publies('actualites'), publies('evenements'), publies('activites'), publies('offres'),
  ]);
  return locales.flatMap((lang) => [
    ...projets.map((entry) => ({ params: { lang, section: slugs[lang].projects, slug: entry.id }, props: { kind: 'projects' as const, entry } })),
    ...actualites.map((entry) => ({ params: { lang, section: slugs[lang].news, slug: entry.id }, props: { kind: 'news' as const, entry } })),
    ...evenements.map((entry) => ({ params: { lang, section: slugs[lang].events, slug: entry.id }, props: { kind: 'events' as const, entry } })),
    ...activites.map((entry) => ({ params: { lang, section: slugs[lang].activities, slug: entry.id }, props: { kind: 'activities' as const, entry } })),
    ...offres.map((entry) => ({ params: { lang, section: slugs[lang].offers, slug: entry.id }, props: { kind: 'offers' as const, entry } })),
  ]);
}
const lang = Astro.params.lang as Locale;
const props = Astro.props;
---
{props.kind === 'projects' ? <ProjetDetail lang={lang} entry={props.entry} /> : <Details lang={lang} {...(props as any)} />}
