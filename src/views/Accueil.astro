---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Img from '../components/Img.astro';
import CarteListe from '../components/CarteListe.astro';
import PdfLink from '../components/PdfLink.astro';
import { getSettings, telHref } from '../lib/settings';
import { getPresentation } from '../lib/presentation';
import { publies, parOrdre, parDateDesc, offresParEtat, titreDe, nomDe, citation } from '../lib/contenu';
import { t, pick, pagePath, detailPath, formatDate, dp, type Locale } from '../i18n';

// Page d'accueil : un résumé de tout le site. Chaque section n'apparaît que si elle a du contenu publié.
interface Props { lang: Locale; }
const { lang } = Astro.props;
const settings = await getSettings();
const p = await getPresentation();

const projets = parOrdre(await publies('projets'), (e) => e.data.titre).slice(0, 3);
const zones = parOrdre(await publies('zones'), (e) => e.data.nom);
const actus = parDateDesc(await publies('actualites'), (e) => e.data.date).slice(0, 3);
const evenements = parDateDesc(await publies('evenements'), (e) => e.data.date).slice(0, 3);
const photos = parDateDesc((await publies('galerie')).filter((g) => g.data.image.image), (g) => g.data.date).slice(0, 6);
const offres = (await offresParEtat()).enCours.slice(0, 3);
const rapports = (await publies('rapports')).filter((r) => r.data.fichierPdf).sort((a, b) => b.data.annee - a.data.annee).slice(0, 2);
const partenaires = parOrdre(await publies('partenaires'), (e) => e.data.nom);
const alternates = { fr: pagePath('fr', 'home'), en: pagePath('en', 'home') };
const accroche = pick(p.accroche, lang);
const img = (x: { image: any; alt: { fr: string; en: string } }) => (x.image ? { src: x.image, alt: pick(x.alt, lang) } : null);
const siege = settings.bureaux[0];
// Logo en filigrane du bandeau d'accueil : la version anglaise sur les pages anglaises si elle existe.
const logoFond = (lang === 'en' && settings.logoEn.image) || settings.logo.image;
---
<Base lang={lang} title={settings.sigle} pageKey="home" alternates={alternates} description={accroche || undefined}>
  <div class="home">
    {/* 1. Bandeau d'accueil : fond gris dégradé, logo qui défile en filigrane derrière le titre. */}
    <section class="sec hero-sec">
      {logoFond && (
        <div class="filigrane" aria-hidden="true">
          {[0, 1].map((rangee) => (
            <div class:list={['bande', `bande-${rangee}`]}>
              {Array.from({ length: 12 }, () => <Image src={logoFond} alt="" width={140} format="webp" quality={60} loading="eager" />)}
            </div>
          ))}
        </div>
      )}
      <div class="wrap hero">
        <div class="stack-l hero-txt">
          {pick(p.surtitre, lang) && <p class="kicker">{pick(p.surtitre, lang)}</p>}
          <h1><span class="sigle">{settings.sigle}</span> <span class="nom">{pick(settings.nom, lang)}</span></h1>
          {accroche && <p class="lead">{accroche}</p>}
          <div class="row">
            <a class="btn btn-p btn-full-m" href={pagePath(lang, 'projects')}>{t(lang, 'home.cta.projects')}</a>
            <a class="btn btn-s btn-full-m" href={pagePath(lang, 'contact')}>{t(lang, 'home.cta.contact')}</a>
          </div>
        </div>
      </div>
      <a class="descendre" href="#suite" aria-label={t(lang, 'home.scroll')}>
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
      </a>
    </section>

    {/* 2. Chiffres clés */}
    {p.chiffres.length > 0 && (
      <section class="sec" id="suite">
        <div class="wrap stack-l">
          <h2>{t(lang, 'home.facts')}</h2>
          <ul class="plain g3">
            {p.chiffres.map((c) => <li class="card fact"><b>{c.valeur}</b>{pick(c.libelle, lang)}</li>)}
          </ul>
        </div>
      </section>
    )}

    {/* 3. Qui sommes-nous : fond bleu dégradé posé sur la photo d'accueil. */}
    {(pick(p.statut, lang) || pick(p.mission, lang) || pick(p.vision, lang)) && (
      <section class="sec about-sec" id={p.chiffres.length > 0 ? undefined : 'suite'}>
        {p.imageAccueil.image && <div class="about-photo" aria-hidden="true"><Img src={p.imageAccueil.image} alt="" sizes="100vw" /></div>}
        <div class="wrap stack-l about">
          <div class="stack">
            <h2>{t(lang, 'home.about')}</h2>
            {pick(p.statut, lang) && <p class="lead">{pick(p.statut, lang)}</p>}
            {pick(p.mission, lang) && <p class="mission"><b>{t(lang, 'home.mission')}{dp(lang)}</b> {pick(p.mission, lang)}</p>}
            <p><a class="btn btn-o" href={pagePath(lang, 'about')}>{t(lang, 'home.about.more')}</a></p>
          </div>
          {pick(p.vision, lang) && (
            <blockquote class="vision">
              <p class="kicker">{t(lang, 'home.vision')}</p>
              <p class="quote">{citation(pick(p.vision, lang), lang)}</p>
            </blockquote>
          )}
        </div>
      </section>
    )}

    {/* 4. Axes d'intervention */}
    {p.axes.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.axes')}</h2><a class="lnk" href={pagePath(lang, 'about')}>{t(lang, 'home.axes.more')}</a></div>
          <div class="g3">
            {p.axes.map((a) => (
              <article class="card axe">
                <h3>{pick(a.titre, lang)}</h3>
                {pick(a.texte, lang) && <p>{pick(a.texte, lang)}</p>}
                {a.points.length > 0 && <ul class="bullets small">{a.points.slice(0, 4).map((x) => <li>{pick(x, lang)}</li>)}</ul>}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* 5. Projets */}
    {projets.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.projects')}</h2><a class="lnk" href={pagePath(lang, 'projects')}>{t(lang, 'home.projects.all')}</a></div>
          <div class="g3">
            {projets.map((e) => <CarteListe href={detailPath(lang, 'projects', e.id)} titre={titreDe(e.data, lang)} image={img(e.data.imagePrincipale)} />)}
          </div>
        </div>
      </section>
    )}

    {/* 6. Zones d'intervention */}
    {zones.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.zones')}</h2><a class="lnk" href={pagePath(lang, 'zones')}>{t(lang, 'home.zones.all')}</a></div>
          <ul class="plain g3">
            {zones.map((z) => (
              <li class="card zone">
                <h3>{lang === 'en' && z.data.nomEn ? z.data.nomEn : z.data.nom}</h3>
                {pick(z.data.territoire, lang) && <p class="small muted">{pick(z.data.territoire, lang).split(/\s*[;\n]\s*/).filter(Boolean).map((x) => x.replace(/\s*\(.*?\)/g, '')).join(', ')}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* 7. Actualités */}
    {actus.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.news')}</h2><a class="lnk" href={pagePath(lang, 'news')}>{t(lang, 'home.news.all')}</a></div>
          <div class="g3">
            {actus.map((e) => (
              <CarteListe href={detailPath(lang, 'news', e.id)} titre={titreDe(e.data, lang)} image={img(e.data.imagePrincipale)}
                surtitre={formatDate(e.data.date, lang)} texte={pick(e.data.resume, lang) || null} />
            ))}
          </div>
        </div>
      </section>
    )}

    {/* 8. Événements */}
    {evenements.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.events')}</h2><a class="lnk" href={pagePath(lang, 'events')}>{t(lang, 'home.events.all')}</a></div>
          <div class="g3">
            {evenements.map((e) => (
              <CarteListe href={detailPath(lang, 'events', e.id)} titre={titreDe(e.data, lang)} image={img(e.data.image)}
                surtitre={[formatDate(e.data.date, lang), pick(e.data.lieu, lang)].filter(Boolean).join(' · ')} />
            ))}
          </div>
        </div>
      </section>
    )}

    {/* 9. Galerie */}
    {photos.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.gallery')}</h2><a class="lnk" href={pagePath(lang, 'gallery')}>{t(lang, 'home.gallery.all')}</a></div>
          <ul class="plain photos">
            {photos.map((g) => <li><Img src={g.data.image.image!} alt={pick(g.data.image.alt, lang) || titreDe(g.data, lang)} sizes="(min-width: 768px) 33vw, 50vw" /></li>)}
          </ul>
        </div>
      </section>
    )}

    {/* 10. Offres en cours */}
    {offres.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.offers')}</h2><a class="lnk" href={pagePath(lang, 'offers')}>{t(lang, 'home.offers.all')}</a></div>
          <div class="g3">
            {offres.map((e) => (
              <CarteListe href={detailPath(lang, 'offers', e.id)} titre={titreDe(e.data, lang)}
                surtitre={e.data.dateLimite ? `${t(lang, 'offers.deadline')}${dp(lang)} ${formatDate(e.data.dateLimite, lang)}` : null} />
            ))}
          </div>
        </div>
      </section>
    )}

    {/* 11. Publications */}
    {rapports.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.reports')}</h2><a class="lnk" href={pagePath(lang, 'reports')}>{t(lang, 'home.reports.all')}</a></div>
          <div class="g2">
            {rapports.map((r) => <PdfLink lang={lang} href={r.data.fichierPdf!} title={titreDe(r.data, lang)} detail={String(r.data.annee)} />)}
          </div>
        </div>
      </section>
    )}

    {/* 12. Partenaires */}
    {partenaires.length > 0 && (
      <section class="sec">
        <div class="wrap stack-l">
          <div class="sec-head"><h2>{t(lang, 'home.partners')}</h2><a class="lnk" href={pagePath(lang, 'partners')}>{t(lang, 'home.partners.all')}</a></div>
          {/* Bandeau qui défile : la liste est répétée une fois (cachée aux lecteurs d'écran) pour une boucle continue. */}
          <div class="defile">
            <ul class="plain piste">
              {[false, true].map((copie) => partenaires.map((e) => (
                <li class="partner" aria-hidden={copie ? 'true' : undefined}>
                  {e.data.logo.image && <div class="logo-box"><Img src={e.data.logo.image} alt={copie ? '' : pick(e.data.logo.alt, lang) || nomDe(e.data, lang)} sizes="200px" /></div>}
                  <span>{nomDe(e.data, lang)}</span>
                </li>
              )))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {/* 13. Nous joindre */}
    <section class="sec contact-sec">
      <div class="wrap g2">
        <div class="stack">
          <h2>{t(lang, 'home.contact')}</h2>
          <p>{t(lang, 'home.work.text')}</p>
          <ul class="plain stack-s">
            {settings.courriels.map((m) => <li><a class="lnk" href={`mailto:${m}`}>{m}</a></li>)}
            {settings.telephones.map((tel) => <li><a class="lnk" href={telHref(tel)}>{tel}</a></li>)}
          </ul>
        </div>
        <div class="stack">
          {siege && <div class="card"><h3>{pick(siege.nom, lang)}</h3><p>{pick(siege.adresse, lang)}</p></div>}
          <div class="row">
            <a class="btn btn-p btn-full-m" href={pagePath(lang, 'contact')}>{t(lang, 'home.work.cta')}</a>
            <a class="btn btn-o btn-full-m" href={pagePath(lang, 'donate')}>{t(lang, 'home.donate')}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Sections alternées blanc / bleu très clair, quel que soit le nombre de sections affichées. */
  .home > .sec:nth-child(even) { background: var(--c-surface); }
  .home > .sec.contact-sec { background: var(--c-header); color: #FFFFFF; }
  .contact-sec :global(a.lnk) { color: #FFFFFF; }
  .contact-sec :global(a.lnk:hover) { color: var(--c-gold); }
  .contact-sec .card { background: transparent; border-color: rgba(255, 255, 255, .3); }
  .contact-sec .btn-p { background: var(--c-gold); border-color: var(--c-gold); color: var(--c-header); }
  .contact-sec .btn-p:hover { background: #FFFFFF; border-color: #FFFFFF; color: var(--c-header); }
  .contact-sec :focus-visible { outline-color: var(--c-gold); }
  .contact-sec .btn-o { background: transparent; border-color: #FFFFFF; color: #FFFFFF; }
  .contact-sec .btn-o:hover { border-color: var(--c-gold); color: var(--c-gold); }

  /* ---------- Bandeau d'accueil ---------- */
  .home > .sec.hero-sec {
    display: flex; align-items: center; min-height: min(78vh, 720px); padding: 64px 0 88px;
    background:
      radial-gradient(var(--hero-dots) 1px, transparent 1.5px) 0 0 / 22px 22px,
      linear-gradient(160deg, var(--hero-1) 0%, var(--hero-2) 45%, var(--hero-3) 100%);
  }
  .hero { position: relative; z-index: 1; display: flex; justify-content: center; }
  .hero-txt { max-width: 860px; align-items: center; text-align: center; }
  .hero h1 { display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--c-title); }
  .hero .sigle {
    font-size: clamp(52px, 11vw, 112px); line-height: 1; letter-spacing: .04em;
    background: linear-gradient(100deg, var(--c-title) 0%, var(--c-accent) 40%, #C9A10F 50%, var(--c-accent) 60%, var(--c-title) 100%) 0 0 / 250% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: reflet 7s ease-in-out infinite;
  }
  .hero .nom { font-size: clamp(22px, 3.2vw, 36px); line-height: 1.25; text-wrap: balance; }
  .hero .lead { max-width: 680px; color: var(--c-text); }
  .hero .row { justify-content: center; }
  @keyframes reflet { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } }

  /* Logo en filigrane : deux rangées qui défilent en sens contraire. */
  .filigrane { position: absolute; inset: 0; z-index: 0; display: flex; flex-direction: column; justify-content: center; gap: 48px; overflow: hidden; pointer-events: none; }
  .bande { display: flex; gap: 72px; width: max-content; opacity: .07; animation: defile 70s linear infinite; }
  .bande-1 { animation-direction: reverse; animation-duration: 90s; margin-left: -120px; }
  .bande img { width: 140px; height: auto; flex: none; filter: grayscale(.2); }

  .descendre {
    position: absolute; z-index: 1; left: 50%; bottom: 20px; translate: -50% 0;
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    border: 1px solid var(--c-border-strong); border-radius: 50%; color: var(--c-title);
    animation: invite 2.4s ease-in-out infinite;
  }
  .descendre:hover { background: var(--c-title); color: var(--c-bg); }
  @keyframes invite { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(8px); } }

  /* ---------- Qui sommes-nous : photo sous un dégradé bleu ---------- */
  .home > .sec.about-sec { position: relative; overflow: hidden; isolation: isolate; background: var(--c-header); color: #FFFFFF; }
  .about-sec::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(135deg, rgba(18, 31, 69, .95) 0%, rgba(26, 46, 102, .88) 45%, rgba(31, 74, 168, .8) 100%);
  }
  .about-photo { position: absolute; inset: 0; z-index: -2; }
  .about-photo :global(img) { width: 100%; height: 100%; object-fit: cover; animation: zoomLent 24s ease-in-out infinite alternate; }
  @keyframes zoomLent { from { transform: scale(1); } to { transform: scale(1.12) translate(-1%, -1%); } }
  .about { max-width: 900px; align-items: center; text-align: center; }
  .about .lead, .about .mission { color: #FFFFFF; }
  .about .btn-o { background: transparent; border-color: #FFFFFF; color: #FFFFFF; }
  .about .btn-o:hover { background: var(--c-gold); border-color: var(--c-gold); color: var(--c-header); }
  .about :focus-visible { outline-color: var(--c-gold); }
  .vision {
    margin: 0; padding: 28px 32px; border: 1px solid rgba(255, 255, 255, .25); border-top: 3px solid var(--c-gold);
    border-radius: 12px; background: rgba(255, 255, 255, .08); backdrop-filter: blur(6px);
  }
  .vision .kicker { color: var(--c-gold); }
  .vision .quote { margin-top: 10px; color: #FFFFFF; }

  .axe { border-top: 3px solid var(--c-accent); }
  .zone h3 { color: var(--c-title); }
  .partner .logo-box { background: #FFFFFF; }
  .partner { display: flex; flex-direction: column; justify-content: center; gap: 8px; flex: none; width: 260px; min-height: 76px; padding: 14px 18px; border-left: 3px solid var(--c-gold); border-radius: var(--radius); background: var(--c-bg); box-shadow: 0 6px 16px -14px rgba(26, 46, 102, .5); font-size: 15px; font-weight: 700; }
  .partner .logo-box { aspect-ratio: auto; height: 56px; padding: 6px; border: 0; }
  .fact b { color: var(--c-title); }
</style>
