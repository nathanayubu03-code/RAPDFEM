---
import { Image } from 'astro:assets';
import { getSettings } from '../lib/settings';
import { pick, type Locale } from '../i18n';

interface Props { lang: Locale; dark?: boolean; }
const { lang, dark = false } = Astro.props;
const settings = await getSettings();
const choisi = dark && settings.logoFondSombre.image ? settings.logoFondSombre : settings.logo;
---
{choisi.image
  ? <Image class="logo-img" src={choisi.image} alt={pick(choisi.alt, lang)} height={112} loading="eager" />
  : <span class="logo-txt">{settings.sigle}</span>}
<style>
  .logo-img { width: auto; height: 40px; }
  .logo-txt { font-size: 22px; font-weight: 700; letter-spacing: .02em; line-height: 1; }
  @media (min-width: 1024px) {
    .logo-img { height: 56px; }
    .logo-txt { font-size: 26px; }
  }
</style>
