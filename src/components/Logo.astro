---
import { Image } from 'astro:assets';
import { getSettings } from '../lib/settings';
import { pick, type Locale } from '../i18n';

// Logo choisi dans l'admin (Logo et coordonnées), suivi du sigle pour rester lisible en petit.
interface Props { lang: Locale; dark?: boolean; }
const { lang, dark = false } = Astro.props;
const settings = await getSettings();
const choisi = dark && settings.logoFondSombre.image ? settings.logoFondSombre : settings.logo;
---
<span class="logo-wrap">
  {choisi.image && <Image class="logo-img" src={choisi.image} alt={pick(choisi.alt, lang)} height={112} densities={[1, 2]} format="webp" loading="eager" />}
  <span class="logo-txt">{settings.sigle}</span>
</span>
<style>
  .logo-wrap { display: inline-flex; align-items: center; gap: 10px; }
  .logo-img { width: auto; height: 44px; }
  .logo-txt { font-size: 22px; font-weight: 700; letter-spacing: .02em; line-height: 1; }
  @media (min-width: 1024px) {
    .logo-img { height: 56px; }
    .logo-txt { font-size: 26px; }
  }
</style>
