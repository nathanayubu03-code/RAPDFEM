---
import Logo from './Logo.astro';
import Reseaux from './Reseaux.astro';
import { getSettings, telHref } from '../lib/settings';
import { t, pick, pagePath, footerNav, dp, type Locale } from '../i18n';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const settings = await getSettings();
const year = new Date().getFullYear();
const hasContact = settings.courriels.length > 0 || settings.telephones.length > 0;
---
<footer class="ft">
  <div class="ft-in">
    <div class="ft-col">
      <div class="ft-logo"><Logo lang={lang} dark /></div>
      {pick(settings.presentationCourte, lang) && <p>{pick(settings.presentationCourte, lang)}</p>}
    </div>
    {hasContact && (
      <div class="ft-col">
        <h2>{t(lang, 'footer.contact')}</h2>
        <ul class="plain">
          {settings.courriels.map((m) => <li><a href={`mailto:${m}`}>{m}</a></li>)}
          {settings.telephones.map((p) => <li><a href={telHref(p)}>{p}</a></li>)}
        </ul>
      </div>
    )}
    {settings.bureaux.length > 0 && (
      <div class="ft-col">
        <h2>{t(lang, 'footer.offices')}</h2>
        {settings.bureaux.map((b) => <p><b>{pick(b.nom, lang)}{dp(lang)}</b> {pick(b.adresse, lang)}</p>)}
      </div>
    )}
    <nav class="ft-col" aria-label={t(lang, 'site.footerNav')}>
      <h2>{t(lang, 'footer.links')}</h2>
      <ul class="plain ft-links">
        {footerNav.map((l) => <li><a href={pagePath(lang, l.key)}>{t(lang, l.label)}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="ft-bot">
    <p>© {year} {settings.sigle}</p>
    <Reseaux lang={lang} />
  </div>
</footer>

<style>
  .ft { border-top: 4px solid var(--c-gold); background: var(--c-footer); color: #FFFFFF; font-size: 14px; line-height: 1.6; }
  .ft a { color: #FFFFFF; }
  .ft a:hover { color: #FFFFFF; text-decoration-thickness: 2px; }
  .ft-in {
    display: grid; gap: 24px;
    max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto;
    padding: 40px var(--gutter);
  }
  .ft h2 { margin-bottom: 8px; font-size: 16px; color: #FFFFFF; }
  .ft-logo { margin-bottom: 12px; }

  /* Logo du pied de page : anneau or qui tourne, onde qui se répète, logo qui respire. */
  .ft-logo :global(.logo-wrap) { --h: 44px; position: relative; }
  .ft-logo :global(.logo-wrap)::before, .ft-logo :global(.logo-wrap)::after {
    content: ""; position: absolute; left: -6px; top: 50%; width: calc(var(--h) + 12px); height: calc(var(--h) + 12px);
    margin-top: calc((var(--h) + 12px) / -2); border-radius: 50%; pointer-events: none;
  }
  .ft-logo :global(.logo-wrap)::before {
    background: conic-gradient(from 0deg, var(--c-gold), transparent 35%, rgba(255, 255, 255, .7) 50%, transparent 65%, var(--c-gold));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
            mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
    animation: ftTourne 8s linear infinite;
  }
  .ft-logo :global(.logo-wrap)::after { border: 2px solid var(--c-gold); opacity: 0; animation: ftOnde 4s ease-out infinite; }
  .ft-logo :global(.logo-img) { animation: ftRespire 4s ease-in-out infinite; }
  @keyframes ftTourne { to { transform: rotate(1turn); } }
  @keyframes ftOnde { 0% { opacity: .8; transform: scale(1); } 60%, 100% { opacity: 0; transform: scale(1.7); } }
  @keyframes ftRespire { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }
  @media (min-width: 1024px) { .ft-logo :global(.logo-wrap) { --h: 56px; } }
  @media (prefers-reduced-motion: reduce) {
    .ft-logo :global(.logo-wrap)::before, .ft-logo :global(.logo-wrap)::after, .ft-logo :global(.logo-img) { animation: none; }
    .ft-logo :global(.logo-wrap)::after { display: none; }
  }
  .ft-col p + p { margin-top: 8px; }
  .ft-links a { display: inline-block; padding: 10px 0; }
  .ft-bot {
    display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between;
    max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto;
    padding: 16px var(--gutter); border-top: 1px solid var(--c-footer-line);
  }
  .ft-bot .row { gap: 8px 16px; }
  @media (min-width: 768px) {
    .ft-in { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .ft-in { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, .8fr); gap: 32px; padding: 56px var(--gutter); }
    .ft-links a { padding: 4px 0; }
  }
</style>
