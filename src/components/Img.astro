---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Image optimisée : WebP, plusieurs tailles selon l'écran, chargement différé par défaut.
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Photo affichée en pleine largeur : version 1920 px en plus, et compression plus fine. */
  large?: boolean;
}
const { src, alt, sizes = '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw', eager = false, class: cls, large = false } = Astro.props;
const widths = (large ? [360, 720, 1080, 1440, 1920] : [360, 720, 1080, 1440]).filter((w) => w <= src.width);
// Toujours proposer aussi la taille d'origine si elle dépasse la plus grande version : rien n'est perdu sur une petite photo.
if (widths.length === 0 || (src.width > (widths.at(-1) ?? 0) && src.width < (large ? 1920 : 1440))) widths.push(src.width);
---
<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={large ? 82 : 75}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class={cls}
/>
