---
import Logo from './Logo.astro';
import Reseaux from './Reseaux.astro';
import { getSettings, telHref } from '../lib/settings';
import {
  t, pagePath, navLabel, mobileNav, desktopNav, desktopLabel, navGroup, locales,
  type Locale, type PageKey,
} from '../i18n';

interface Props {
  lang: Locale;
  pageKey: PageKey | null;
  /** Adresse de la page courante dans chaque langue. */
  alternates?: Record<Locale, string> | undefined;
}
const { lang, pageKey, alternates } = Astro.props;
const settings = await getSettings();
const group = pageKey ? (navGroup[pageKey] ?? pageKey) : null;
const langHref = (l: Locale) => alternates?.[l] ?? pagePath(l, 'home');
---
<a class="skip" href="#main">{t(lang, 'site.skip')}</a>
<header class="hd">
  {/* Bandeau fin au-dessus du menu : courriel et téléphone à gauche, réseaux sociaux à droite. */}
  <div class="hd-top">
    <div class="hd-top-in">
      <p class="hd-contact">
        {settings.courriels[0] && <a href={`mailto:${settings.courriels[0]}`}>{settings.courriels[0]}</a>}
        {settings.telephones[0] && <a href={telHref(settings.telephones[0])}>{settings.telephones[0]}</a>}
      </p>
      <Reseaux lang={lang} class="rs-hd" />
    </div>
  </div>
  <div class="hd-in">
    <a class="logo" href={pagePath(lang, 'home')} aria-label={`${settings.sigle}, ${t(lang, 'site.home')}`}>
      <Logo lang={lang} />
    </a>
    <nav class="nav" aria-label={t(lang, 'site.mainNav')}>
      {desktopNav.map((k) => (
        <a href={pagePath(lang, k)} aria-current={k === group ? 'page' : undefined}>{t(lang, desktopLabel[k] ?? navLabel[k])}</a>
      ))}
    </nav>
    <a class="don" href={pagePath(lang, 'donate')} aria-current={pageKey === 'donate' ? 'page' : undefined}>{t(lang, 'nav.donate')}</a>
    <div class="hd-r">
      {/* Mode clair / sombre : lune en mode clair, soleil en mode sombre. */}
      <button class="theme" type="button" aria-pressed="false" title={t(lang, 'site.theme')}>
        <span class="visually-hidden">{t(lang, 'site.theme')}</span>
        <svg class="ic-lune" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="ic-soleil" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <nav class="lang" aria-label={t(lang, 'site.langLabel')}>
        {locales.map((l) => (
          <a href={langHref(l)} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
      <Reseaux lang={lang} class="rs-menu" />
      <button class="burger" type="button" aria-expanded="false" aria-controls="mnav">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        {t(lang, 'site.menu')}
      </button>
    </div>
  </div>
  <nav class="mnav" id="mnav" aria-label={t(lang, 'site.mainNav')}>
    <ul class="plain">
      {mobileNav.map((k) => (
        <li><a class:list={[{ 'm-don': k === 'donate' }]} href={pagePath(lang, k)} aria-current={k === pageKey ? 'page' : undefined}>{t(lang, navLabel[k])}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Seul JavaScript du site : menu mobile et mémorisation de la langue choisie.
  document.querySelectorAll<HTMLAnchorElement>('.lang a[lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('rapdfem-langue', a.lang); } catch { /* stockage indisponible : sans effet */ }
    });
  });
  // Bouton mode clair / sombre : le choix est mémorisé pour les visites suivantes.
  const theme = document.querySelector<HTMLButtonElement>('.theme');
  if (theme) {
    const racine = document.documentElement;
    const sombre = () => racine.dataset.theme === 'dark' || (!racine.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const maj = () => theme.setAttribute('aria-pressed', String(sombre()));
    maj();
    theme.addEventListener('click', () => {
      const choix = sombre() ? 'light' : 'dark';
      racine.dataset.theme = choix;
      try { localStorage.setItem('rapdfem-theme', choix); } catch { /* stockage indisponible : choix valable pour cette page */ }
      maj();
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', maj);
  }

  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('mnav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
  }
</script>

<style>
  .skip {
    position: absolute; left: 16px; top: -100px; z-index: 10;
    padding: 12px 16px; background: var(--c-gold); color: var(--c-header);
    font-weight: 700; border-radius: var(--radius);
  }
  .skip:focus { top: 8px; color: var(--c-header); }

  /* En-tête bleu profond, lueur d'or : filet en haut, page active et focus en or. */
  .hd { border-top: 4px solid var(--c-gold); background: var(--c-header); color: #FFFFFF; }
  .hd :focus-visible { outline-color: var(--c-gold); }
  .hd-in {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 64px; max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin: 0 auto; padding: 8px var(--gutter);
  }
  .logo { display: flex; align-items: center; flex: none; min-height: var(--tap); color: #FFFFFF; text-decoration: none; }
  .logo:hover { color: var(--c-gold); }
  /* Petits téléphones : le logo seul, pour laisser la place à la langue et au menu. */
  @media (max-width: 419px) { .logo :global(.logo-txt) { display: none; } }
  /* Ordinateurs (menu complet affiché) : le logo seul, le menu prend la place. */
  @media (min-width: 1280px) { .logo :global(.logo-txt) { display: none; } }
  .hd-r { display: flex; align-items: center; gap: 8px; }

  /* Bandeau des réseaux sociaux */
  .hd-top { background: rgba(0, 0, 0, .22); border-bottom: 1px solid rgba(255, 255, 255, .1); font-size: 13px; }
  .hd-top-in {
    display: flex; align-items: center; justify-content: center; gap: 8px 24px; flex-wrap: wrap;
    max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: 4px var(--gutter);
  }
  .hd-top:not(:has(.reseaux)) { display: none; }
  .hd-contact { display: none; gap: 20px; }
  .hd-contact a { color: var(--c-header-soft); text-decoration: none; }
  .hd-contact a:hover { color: var(--c-gold); }
  .hd-top :global(.rs) { width: 32px; height: 32px; color: #FFFFFF; border-color: rgba(255, 255, 255, .35); }
  .hd-top :global(.rs svg) { width: 15px; height: 15px; }
  .hd-r :global(ul.rs-menu) { display: none; }
  @media (min-width: 768px) {
    .hd-top:not(:has(.reseaux)) { display: block; }
    .hd-top-in { justify-content: space-between; }
    .hd-contact { display: flex; }
  }

  /* Logo du menu : il apparaît, rebondit trois fois, se retire, puis recommence. */
  .logo :global(.logo-img) { transform-origin: 50% 100%; animation: rebond 9s cubic-bezier(.3, .7, .4, 1) infinite; }
  @keyframes rebond {
    0% { opacity: 0; transform: scale(.55); }
    7% { opacity: 1; transform: scale(1.06); }
    10% { transform: scale(1); }
    15% { transform: translateY(-12px); }
    20% { transform: translateY(0) scale(1.04, .94); }
    25% { transform: translateY(-8px); }
    30% { transform: translateY(0) scale(1.03, .96); }
    34% { transform: translateY(-4px); }
    38% { transform: translateY(0); }
    84% { opacity: 1; transform: none; }
    93% { opacity: 0; transform: scale(.55) rotate(-8deg); }
    100% { opacity: 0; transform: scale(.55); }
  }
  @media (prefers-reduced-motion: reduce) { .logo :global(.logo-img) { animation: none; } }

  .lang { display: inline-flex; flex: none; border: 1px solid var(--c-header-soft); border-radius: var(--radius); overflow: hidden; }
  .lang a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 42px; font-size: 14px; font-weight: 700;
    color: #FFFFFF; text-decoration: none;
  }
  .lang a:hover { color: var(--c-gold); }
  .lang a[aria-current] { background: var(--c-gold); color: var(--c-header); }

  /* Bouton mode clair / sombre (masqué sans JavaScript, il ne pourrait rien faire). */
  .theme {
    display: none; align-items: center; justify-content: center; flex: none; width: 42px; height: 42px;
    border: 1px solid var(--c-header-soft); border-radius: 50%; background: transparent; color: #FFFFFF; cursor: pointer;
    transition: color .2s, border-color .2s, transform .4s cubic-bezier(.22, .61, .36, 1);
  }
  :global(.js) .theme { display: inline-flex; }
  .theme:hover { color: var(--c-gold); border-color: var(--c-gold); transform: rotate(20deg); }
  .theme .ic-soleil, .theme[aria-pressed="true"] .ic-lune { display: none; }
  .theme[aria-pressed="true"] .ic-soleil { display: block; color: var(--c-gold); }

  /* Sans JavaScript, le menu mobile reste visible et le bouton est masqué. */
  .burger {
    display: none; align-items: center; gap: 6px; min-height: var(--tap); padding: 0 12px;
    border: 1px solid var(--c-header-soft); border-radius: var(--radius);
    background: transparent; color: #FFFFFF; font: 700 14px/1 var(--font); cursor: pointer;
  }
  .burger:hover { border-color: var(--c-gold); color: var(--c-gold); }
  :global(.js) .burger { display: inline-flex; }
  :global(.js) .mnav:not(.open) { display: none; }

  .mnav { background: var(--c-header); }
  .mnav a {
    display: flex; align-items: center; min-height: 48px; padding: 0 var(--gutter);
    border-top: 1px solid rgba(255, 255, 255, .15); color: #FFFFFF; font-weight: 700; text-decoration: none;
  }
  .mnav a:hover { color: var(--c-gold); }
  .mnav a[aria-current] { color: var(--c-gold); box-shadow: inset 4px 0 0 var(--c-gold); }

  .nav { display: none; }
  .don { display: none; }
  .mnav a.m-don { color: var(--c-gold); }

  /* Menu horizontal : à partir de 1280 px, les 8 entrées tiennent sur une ligne. */
  @media (min-width: 1280px) {
    /* Le bandeau du haut disparaît : les icônes passent au bout du menu, à droite. */
    .hd-top, .hd-top:not(:has(.reseaux)) { display: none; }
    .hd-in { min-height: 80px; max-width: 1440px; padding: 12px 24px; gap: 14px; }
    .hd-r { gap: 10px; }
    .theme { width: 36px; height: 36px; }
    .hd-r :global(ul.rs-menu) { display: flex; flex-wrap: nowrap; gap: 4px; padding-left: 12px; border-left: 1px solid rgba(255, 255, 255, .2); }
    .hd-r :global(.rs-menu .rs) { width: 30px; height: 30px; color: #FFFFFF; border-color: rgba(255, 255, 255, .35); }
    .hd-r :global(.rs-menu .rs svg) { width: 14px; height: 14px; }
    .nav { display: flex; align-items: center; flex: 1; justify-content: flex-end; }
    .nav a {
      display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 6px;
      color: #FFFFFF; font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap;
    }
    .nav a:hover { color: var(--c-gold); }
    .nav a[aria-current] { color: var(--c-gold); box-shadow: inset 0 -3px 0 var(--c-gold); }
    /* Bouton « Faire un don » : or sur bleu, bien visible sans être criard. */
    .don {
      display: inline-flex; align-items: center; flex: none; min-height: 40px; padding: 0 14px;
      border: 2px solid var(--c-gold); border-radius: var(--radius);
      background: var(--c-gold); color: var(--c-header); font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap;
    }
    .don:hover, .don[aria-current] { background: transparent; color: var(--c-gold); }
    .burger, :global(.js) .burger { display: none; }
    .mnav, :global(.js) .mnav.open { display: none; }
  }
</style>
