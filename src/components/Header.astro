---
import Logo from './Logo.astro';
import { getSettings } from '../lib/settings';
import {
  t, pagePath, navLabel, mobileNav, desktopNav, navGroup, locales,
  type Locale, type PageKey,
} from '../i18n';

interface Props {
  lang: Locale;
  pageKey: PageKey | null;
  /** Adresse de la page courante dans chaque langue. */
  alternates?: Record<Locale, string> | undefined;
}
const { lang, pageKey, alternates } = Astro.props;
const settings = await getSettings();
const group = pageKey ? (navGroup[pageKey] ?? pageKey) : null;
const langHref = (l: Locale) => alternates?.[l] ?? pagePath(l, 'home');
---
<a class="skip" href="#main">{t(lang, 'site.skip')}</a>
<header class="hd">
  <div class="hd-in">
    <a class="logo" href={pagePath(lang, 'home')} aria-label={`${settings.sigle}, ${t(lang, 'site.home')}`}>
      <Logo lang={lang} />
    </a>
    <nav class="nav" aria-label={t(lang, 'site.mainNav')}>
      {desktopNav.map((k) => (
        <a href={pagePath(lang, k)} aria-current={k === group ? 'page' : undefined}>{t(lang, navLabel[k])}</a>
      ))}
    </nav>
    <div class="hd-r">
      <nav class="lang" aria-label={t(lang, 'site.langLabel')}>
        {locales.map((l) => (
          <a href={langHref(l)} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mnav">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        {t(lang, 'site.menu')}
      </button>
    </div>
  </div>
  <nav class="mnav" id="mnav" aria-label={t(lang, 'site.mainNav')}>
    <ul class="plain">
      {mobileNav.map((k) => (
        <li><a href={pagePath(lang, k)} aria-current={k === pageKey ? 'page' : undefined}>{t(lang, navLabel[k])}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Seul JavaScript du site : ouverture et fermeture du menu mobile.
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('mnav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
  }
</script>

<style>
  .skip {
    position: absolute; left: 16px; top: -100px; z-index: 10;
    padding: 12px 16px; background: var(--c-gold); color: var(--c-header);
    font-weight: 700; border-radius: var(--radius);
  }
  .skip:focus { top: 8px; color: var(--c-header); }

  /* En-tête bleu profond, lueur d'or : filet en haut, page active et focus en or. */
  .hd { border-top: 4px solid var(--c-gold); background: var(--c-header); color: #FFFFFF; }
  .hd :focus-visible { outline-color: var(--c-gold); }
  .hd-in {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 64px; max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin: 0 auto; padding: 8px var(--gutter);
  }
  .logo { display: flex; align-items: center; flex: none; min-height: var(--tap); color: #FFFFFF; text-decoration: none; }
  .logo:hover { color: var(--c-gold); }
  /* Petits téléphones : le logo seul, pour laisser la place à la langue et au menu. */
  @media (max-width: 419px) { .logo :global(.logo-txt) { display: none; } }
  .hd-r { display: flex; align-items: center; gap: 8px; }

  .lang { display: inline-flex; flex: none; border: 1px solid var(--c-header-soft); border-radius: var(--radius); overflow: hidden; }
  .lang a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 42px; font-size: 14px; font-weight: 700;
    color: #FFFFFF; text-decoration: none;
  }
  .lang a:hover { color: var(--c-gold); }
  .lang a[aria-current] { background: var(--c-gold); color: var(--c-header); }

  /* Sans JavaScript, le menu mobile reste visible et le bouton est masqué. */
  .burger {
    display: none; align-items: center; gap: 6px; min-height: var(--tap); padding: 0 12px;
    border: 1px solid var(--c-header-soft); border-radius: var(--radius);
    background: transparent; color: #FFFFFF; font: 700 14px/1 var(--font); cursor: pointer;
  }
  .burger:hover { border-color: var(--c-gold); color: var(--c-gold); }
  :global(.js) .burger { display: inline-flex; }
  :global(.js) .mnav:not(.open) { display: none; }

  .mnav { background: var(--c-header); }
  .mnav a {
    display: flex; align-items: center; min-height: 48px; padding: 0 var(--gutter);
    border-top: 1px solid rgba(255, 255, 255, .15); color: #FFFFFF; font-weight: 700; text-decoration: none;
  }
  .mnav a:hover { color: var(--c-gold); }
  .mnav a[aria-current] { color: var(--c-gold); box-shadow: inset 4px 0 0 var(--c-gold); }

  .nav { display: none; }

  /* Menu horizontal : à partir de 1280 px, les 8 entrées tiennent sur une ligne. */
  @media (min-width: 1280px) {
    .hd-in { min-height: 80px; padding: 12px var(--gutter); gap: 20px; }
    .nav { display: flex; align-items: center; flex: 1; justify-content: flex-end; }
    .nav a {
      display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 10px;
      color: #FFFFFF; font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap;
    }
    .nav a:hover { color: var(--c-gold); }
    .nav a[aria-current] { color: var(--c-gold); box-shadow: inset 0 -3px 0 var(--c-gold); }
    .burger, :global(.js) .burger { display: none; }
    .mnav, :global(.js) .mnav.open { display: none; }
  }
</style>
