---
import { t, pagePath, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  lead?: string | undefined;
  /** Étapes intermédiaires du fil d'Ariane (sans l'accueil ni la page courante). */
  trail?: { label: string; href: string }[];
}
const { lang, title, lead, trail = [] } = Astro.props;
---
<div class="wrap">
  <nav class="crumb" aria-label={t(lang, 'site.breadcrumb')}>
    <ol>
      <li><a href={pagePath(lang, 'home')}>{t(lang, 'nav.home')}</a></li>
      {trail.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      <li aria-current="page">{title}</li>
    </ol>
  </nav>
</div>
<section class="sec sec-t">
  <div class="wrap stack narrow">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .sec-t { padding-top: 24px; padding-bottom: 0; }
  @media (min-width: 1024px) { .sec-t { padding-top: 32px; } }
</style>
