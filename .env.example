# Variables Keystatic (mode GitHub). Ne jamais committer les vraies valeurs.
# Sur Cloudflare : les trois premières sont des « secrets » du Worker,
# la dernière est une variable de BUILD (elle est lue au moment de la construction).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# En local uniquement : forcer le mode GitHub au lieu de l'écriture directe des fichiers.
# PUBLIC_KEYSTATIC_STORAGE=github
